{
  "name": "church-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:swa": "swa start http://localhost:3000 --run \"npm run dev\" --api-location ../api",
    "build": "next build && cp staticwebapp.config.json out/staticwebapp.config.json",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test:routes": "node --test scripts/check-routes.mjs",
    "test:lib": "tsx --test src/lib/*.test.ts"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/node": "20.12.7",
    "@types/react": "18.2.21",
    "@types/react-dom": "18.2.7",
    "tsx": "^4.23.13",
    "typescript": "5.4.5"
  },
  "engines": {
    "node": ">=20.9.0 <21"
  }
}
